# Z.AI API key — coding plan, global endpoint (https://api.z.ai)
ZAI_API_KEY=

# Or, if your key is for the China endpoint, use this instead:
# ZAI_CODING_CN_API_KEY=

# Optional: default model (default is glm-5.3)
# TINY_AGENT_MODEL=glm-5.3-flash

# Optional: Context7 API key for the docs tools (works keyless, rate-limited)
# CONTEXT7_API_KEY=

# TypeSafe API key — enables --sidecar (Jev assertions while composing)
# JEV_TOKEN=
